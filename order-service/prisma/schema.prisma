generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Order {
  order_id                String          @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  order_number            String          @unique @db.VarChar(50)
  customer_id             String          @db.Uuid
  courier_id              String?         @db.Uuid
  vehicle_id              String?         @db.Uuid
  status                  String?         @default("PENDING") @db.VarChar(30)
  priority                String?         @default("STANDARD") @db.VarChar(20)
  service_type            String?         @db.VarChar(30)
  estimated_delivery_time DateTime?       @db.Timestamptz(6)
  actual_delivery_time    DateTime?       @db.Timestamptz(6)
  customer_rating         Int?
  created_at              DateTime?       @default(now()) @db.Timestamptz(6)
  updated_at              DateTime?       @default(now()) @updatedAt @db.Timestamptz(6)
  scheduled_pickup_time   DateTime?       @db.Timestamptz(6)
  scheduled_delivery_time DateTime?       @db.Timestamptz(6)
  notes                   String?

  addresses               OrderAddress[]
  parcels                 Parcel[]
  tracking_events         TrackingEvent[]
  courier_assignments     courier_assignments[]

  @@map("orders")
}

model OrderAddress {
  address_id     String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  order_id       String    @db.Uuid
  address_type   String    @db.VarChar(20)
  contact_name   String    @db.VarChar(200)
  contact_phone  String    @db.VarChar(15)
  contact_email  String?   @db.VarChar(255)
  street_address String
  subcity        String    @db.VarChar(100)
  kebele         String    @db.VarChar(100)
  woreda         String?   @db.VarChar(100)
  house_number   String?   @db.VarChar(50)
  landmark       String?
  instructions   String?
  access_codes   String?
  created_at     DateTime? @default(now()) @db.Timestamptz(6)

  order          Order     @relation(fields: [order_id], references: [order_id], onDelete: Cascade, onUpdate: NoAction)

  @@map("order_addresses")
}

model Parcel {
  parcel_id          String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  order_id           String    @db.Uuid
  parcel_number      String    @unique @db.VarChar(50)
  description        String?
  weight_kg          Decimal   @db.Decimal(6, 2)
  length_cm          Decimal?  @db.Decimal(6, 2)
  width_cm           Decimal?  @db.Decimal(6, 2)
  height_cm          Decimal?  @db.Decimal(6, 2)
  declared_value     Decimal?  @db.Decimal(15, 2)
  category           String?   @db.VarChar(50)
  is_fragile         Boolean?  @default(false)
  is_perishable      Boolean?  @default(false)
  requires_signature Boolean?  @default(false)
  insurance_amount   Decimal?  @db.Decimal(15, 2)
  created_at         DateTime? @default(now()) @db.Timestamptz(6)

  order              Order     @relation(fields: [order_id], references: [order_id], onDelete: Cascade, onUpdate: NoAction)

  @@index([order_id], map: "idx_parcels_order")
  @@map("parcels")
}

model TrackingEvent {
  event_id        String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  order_id        String    @db.Uuid
  event_type      String    @db.VarChar(50)
  event_timestamp DateTime? @default(now()) @db.Timestamptz(6)
  location_text   String?   @db.VarChar(500)
  latitude        Decimal?  @db.Decimal(10, 8)
  longitude       Decimal?  @db.Decimal(11, 8)
  courier_id      String?   @db.Uuid
  notes           String?
  created_at      DateTime? @default(now()) @db.Timestamptz(6)

  order           Order     @relation(fields: [order_id], references: [order_id], onDelete: Cascade, onUpdate: NoAction)

  @@index([order_id, event_timestamp], map: "idx_tracking_events_order")
  @@map("tracking_events")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model courier_assignments {
  assignment_id       String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  order_id            String    @db.Uuid
  courier_id          String    @db.Uuid
  vehicle_id          String?   @db.Uuid
  assigned_by         String?   @db.Uuid
  assigned_at         DateTime? @default(now()) @db.Timestamptz(6)
  unassigned_at       DateTime? @db.Timestamptz(6)
  unassignment_reason String?   @db.VarChar(100)
  status              String?   @default("ACTIVE") @db.VarChar(20)

  order               Order     @relation(fields: [order_id], references: [order_id], onDelete: Cascade, onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model delivery_proofs {
  proof_id            String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  order_id            String    @db.Uuid
  proof_type          String    @db.VarChar(30)
  recipient_name      String?   @db.VarChar(200)
  recipient_relation  String?   @db.VarChar(100)
  signature_image_url String?
  photo_urls          String[]
  access_code_used    String?   @db.VarChar(100)
  delivered_at        DateTime? @default(now()) @db.Timestamptz(6)
  created_at          DateTime? @default(now()) @db.Timestamptz(6)
}

model location_updates {
  location_id     String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  order_id        String    @db.Uuid
  courier_id      String    @db.Uuid
  latitude        Decimal   @db.Decimal(10, 8)
  longitude       Decimal   @db.Decimal(11, 8)
  accuracy_meters Decimal?  @db.Decimal(5, 1)
  speed_kph       Decimal?  @db.Decimal(5, 1)
  recorded_at     DateTime? @default(now()) @db.Timestamptz(6)

  @@index([order_id, recorded_at], map: "idx_location_updates_order")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model order_items {
  item_id     String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  parcel_id   String    @db.Uuid
  sku         String?   @db.VarChar(100)
  name        String    @db.VarChar(200)
  description String?
  quantity    Int
  unit_value  Decimal?  @db.Decimal(15, 2)
  created_at  DateTime? @default(now()) @db.Timestamptz(6)
}

enum OrderStatus {
  PENDING
  ASSIGNED
  PICKED_UP
  DELIVERED
  CANCELLED
}
